# ============================================================================
# Zerodha Kite Automated Trading System — environment configuration
# Copy to .env and fill in. NEVER commit the real .env file.
# ============================================================================

# --- Runtime mode ---------------------------------------------------------
# BROKER: "paper" (simulated fills, no real orders), "kite" (Zerodha, live),
# or "groww" (Groww, live). Always start with paper.
BROKER=paper
# DRY_RUN=true short-circuits any real order placement even when BROKER=kite.
DRY_RUN=true
ENV=development                 # development | production
LOG_LEVEL=INFO
TIMEZONE=Asia/Kolkata

# --- Capital & risk -------------------------------------------------------
INITIAL_CAPITAL=100000
RISK_PER_TRADE_PCT=1.0          # % of capital risked per trade
MAX_DAILY_LOSS_PCT=3.0          # halt trading for the day past this loss
MAX_DRAWDOWN_PCT=10.0           # kill switch past this peak-to-trough drawdown
MAX_OPEN_POSITIONS=3
MIN_OPPORTUNITY_SCORE=80        # only trade opportunities scoring above this
ML_CONFIDENCE_THRESHOLD=0.55    # only trade ML probability above this

# --- Zerodha Kite Connect -------------------------------------------------
# Get these from https://developers.kite.trade/
KITE_API_KEY=
KITE_API_SECRET=
# Access token is generated daily via the login flow (scripts/kite_login.py).
KITE_ACCESS_TOKEN=
KITE_USER_ID=

# --- Groww (only needed when BROKER=groww) --------------------------------
# Requires a Groww API subscription + `pip install growwapi pyotp`.
# Supports NSE/BSE equity & F&O (no MCX/commodity).
GROWW_API_KEY=
GROWW_API_SECRET=
# Generate daily via scripts/groww_login.py, or set the TOTP secret to
# auto-generate the access token at startup.
GROWW_ACCESS_TOKEN=
GROWW_TOTP_SECRET=

# --- PostgreSQL -----------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=trading
POSTGRES_USER=trading
POSTGRES_PASSWORD=change-me
# Optional full DSN override; if set it takes precedence over the parts above.
DATABASE_URL=

# --- Redis ----------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# --- Telegram -------------------------------------------------------------
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Dashboard ------------------------------------------------------------
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000
DASHBOARD_API_KEY=change-me     # X-API-Key for programmatic control endpoints

# Dashboard login (web UI).
DASHBOARD_AUTH_ENABLED=true
DASHBOARD_USERNAME=admin
# For first run you can use the plaintext password below. For anything real,
# run `python scripts/set_password.py` and set DASHBOARD_PASSWORD_HASH instead.
DASHBOARD_PASSWORD=admin
DASHBOARD_PASSWORD_HASH=
# Signs session cookies. Set a long random value (the script prints one).
DASHBOARD_SECRET_KEY=

# --- Trading windows (IST, 24h) ------------------------------------------
EQUITY_SESSION_START=09:15
EQUITY_SESSION_END=15:30
SQUARE_OFF_TIME=15:15           # intraday auto square-off
MCX_SESSION_END=23:30
