# =============================================================
# tradingview-mcp — Local Environment Configuration
# =============================================================
# 1. Copy this file:  cp .env.example .env
# 2. Fill in your values below
# 3. .env is in .gitignore — it will NEVER be committed to git
# =============================================================

# ── Proxy (Optional — Webshare Rotating Residential) ──────────
# Get credentials from: https://proxy.webshare.io/proxy/list
# Enables access to Yahoo Finance, Xueqiu, and reduces Reddit rate-limits.
# Leave blank to run WITHOUT proxy (Reddit & RSS will still work).

PROXY_HOST=p.webshare.io
PROXY_PORT=80
PROXY_USERNAME_PREFIX=your_username_prefix   # e.g. hvfvdamo
PROXY_PASSWORD=your_password_here
PROXY_SESSION_MIN=1
PROXY_SESSION_MAX=250

# Set to false to disable proxy entirely
PROXY_ENABLED=true

# =============================================================
# 9/21 EMA Live-Trading System (src/trading_system)
# =============================================================
# These power the Groww-based live-trading module. They are NOT
# needed to run the tradingview-mcp server.

# ── Groww credentials ────────────────────────────────────────
# Create an API key at https://groww.in/trade-api. The key needs
# daily approval on the Groww Cloud API Keys page. GROWW_TOTP_SECRET
# is the TOTP seed string shown when you enable the API; the SDK
# generates a 6-digit TOTP from it and exchanges both for an access
# token. NEVER commit real values; this file is .env.example.
GROWW_API_KEY=your_groww_api_key_here
GROWW_TOTP_SECRET=your_groww_totp_seed_here
GROWW_REQUEST_TIMEOUT_S=10

# ── Database ─────────────────────────────────────────────────
# The docker-compose postgres service uses these defaults; override
# them to point at a managed Postgres (RDS, Supabase, etc).
POSTGRES_DB=trading
POSTGRES_USER=trading
POSTGRES_PASSWORD=trading
DATABASE_URL=postgresql+psycopg2://trading:trading@localhost:5432/trading
DATABASE_ECHO=false

# ── Safety ───────────────────────────────────────────────────
# PAPER_TRADING=true means the live loop simulates orders without
# sending them to Groww. ALWAYS leave this on until you have hand-
# verified the strategy against live data.
PAPER_TRADING=true
APP_TZ=Asia/Kolkata
