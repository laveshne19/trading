<section class="wrap"><h1>{{ collection.title }}</h1>{% if collection.description != blank %}<div>{{ collection.description }}</div>{% endif %}
{% render 'filters', collection: collection %}<ul class="grid" style="list-style:none;padding:0">{% for product in collection.products %}<li>{% render 'product-card', product: product %}</li>{% endfor %}</ul>{{ paginate | default_pagination }}</section>
{% schema %}{ "name": "Collection", "settings": [] }{% endschema %}
