<section class="wrap" style="padding-block:2rem"><h2>{{ section.settings.title }}</h2><ul class="grid" style="list-style:none;padding:0">
{% for product in section.settings.collection.products limit: 8 %}<li>{% render 'product-card', product: product %}</li>{% endfor %}</ul></section>
{% schema %}{ "name": "Featured collection", "settings": [{ "type": "text", "id": "title", "label": "Title", "default": "Featured picks" }, { "type": "collection", "id": "collection", "label": "Collection" }], "presets": [{ "name": "Featured collection" }] }{% endschema %}
