# ---- Core -------------------------------------------------------------
NODE_ENV=development
PORT=4200
# Public base URL (used for canonical URLs, sitemap, OG, webhooks). Domain is bought later.
SITE_URL=http://localhost:4200
# 1 = show "Demo catalogue" notice on product pages. Default: 1 in dev, 0 in production.
DEMO_CATALOGUE=1
# Where runtime JSON data (orders, users, stock...) lives. Default: ./data/runtime
DATA_DIR=
# Random 32+ char secret used to sign order-access tokens. Dev: auto-generated and stored in DATA_DIR.
SESSION_SECRET=

# ---- Admin (HTTP Basic). In production BOTH are required or /admin is disabled.
ADMIN_USER=
ADMIN_PASS=

# ---- Payments ---------------------------------------------------------
# DEV ONLY mock gateway (ignored when NODE_ENV=production). Loudly labelled in UI.
DEV_MOCK_PAYMENT=1
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox            # sandbox | production

# ---- Shipping ---------------------------------------------------------
SHIPPING_PRIMARY=                 # shiprocket | delhivery | dtdc | bluedart (used for PIN serviceability)
PICKUP_PINCODE=                   # warehouse PIN
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=              # use a dedicated API user
SHIPROCKET_PICKUP_LOCATION=Primary
SHIPROCKET_WEBHOOK_TOKEN=         # token you configure in Shiprocket webhook settings (sent as x-api-key)
DELHIVERY_API_TOKEN=
DELHIVERY_ENV=staging             # staging | production
DELHIVERY_PICKUP_NAME=
DTDC_API_KEY=
DTDC_CUSTOMER_CODE=
DTDC_TRACKING_TOKEN=
BLUEDART_CLIENT_ID=
BLUEDART_CLIENT_SECRET=
BLUEDART_LOGIN_ID=
BLUEDART_LICENCE_KEY=

# ---- Notifications ----------------------------------------------------
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=1                     # 1 = implicit TLS (465); 0 = plain/STARTTLS
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
WHATSAPP_NUMBER=                  # public click-to-chat number, digits with country code, e.g. 919XXXXXXXXX
WHATSAPP_CLOUD_TOKEN=             # Meta WhatsApp Cloud API permanent token
WHATSAPP_PHONE_NUMBER_ID=

# ---- Shopify (optional - for export/push scripts and webhooks) --------
SHOPIFY_SHOP=                     # your-store.myshopify.com
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_VERSION=2025-01
SHOPIFY_WEBHOOK_SECRET=
