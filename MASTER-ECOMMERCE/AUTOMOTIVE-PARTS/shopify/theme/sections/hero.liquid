<section class="hero"><div class="container hero__in">
  <span class="eyebrow">{{ section.settings.eyebrow }}</span>
  <h1>{{ section.settings.heading }}</h1>
  <p class="lede">{{ section.settings.subheading }}</p>
  {%- comment -%}Hero photography must be supplied by the business; the local frontend uses abstract SVG art.{%- endcomment -%}
  {% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'eager', alt: section.settings.heading }}{% endif %}
</div></section>
{% schema %}{ "name": "Hero", "settings": [
  { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Lighting & electronics" },
  { "type": "text", "id": "heading", "label": "Heading", "default": "Headlight modules, precisely matched." },
  { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Select your vehicle, confirm the OEM reference, order prepaid." },
  { "type": "image_picker", "id": "image", "label": "Hero image (supply real photography)" } ] }{% endschema %}
