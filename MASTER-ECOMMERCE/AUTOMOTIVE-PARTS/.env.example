# ---- Core ----
PORT=4100
NODE_ENV=development            # set to "production" for deploy
SITE_URL=http://localhost:4100  # canonical domain, e.g. https://your-domain.in (domains bought later)
SITE_NAME=Apex Lumen            # placeholder brand name; change freely
SESSION_SECRET=                 # REQUIRED in production: long random string
DATA_DIR=                       # optional, defaults to ./data
WHATSAPP_NUMBER=                # digits with country code, e.g. 919XXXXXXXXX (shows WhatsApp button when set)
CONTACT_EMAIL=                  # public contact email shown on site
TRUST_PROXY=0                   # 1 when behind a reverse proxy (uses X-Forwarded-For for rate limiting)

# ---- Admin (HTTP Basic) ----
ADMIN_USER=
ADMIN_PASS=                     # REQUIRED in production, admin is disabled if unset. Dev default is printed on boot.

# ---- Dev-only helpers (all refused/ignored in production) ----
DEV_DEMO_PRICES=0               # 1 = derive clearly-labelled DEV PLACEHOLDER prices so cart/checkout can be tested
DEV_MOCK_PAYMENT=0              # 1 = enable loud-labelled mock gateway (only when NODE_ENV != production)

# ---- Payments (prepaid only; COD is not supported) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox            # sandbox | production

# ---- Supplier ----
SUPPLIER_ADAPTER=manual-queue   # manual-queue | alibaba-api
ALIBABA_APP_KEY=
ALIBABA_APP_SECRET=
ALIBABA_ACCESS_TOKEN=
SUPPLIER_PO_EMAIL=              # where PO exports are emailed (optional)

# ---- Couriers ----
DHL_API_KEY=
DHL_API_SECRET=
UPS_CLIENT_ID=
UPS_CLIENT_SECRET=

# ---- Notifications ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0                   # 1 = implicit TLS (port 465)
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ---- Shopify (optional; for shopify/ scripts + webhook) ----
SHOPIFY_STORE_DOMAIN=           # your-store.myshopify.com
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_WEBHOOK_SECRET=         # for /webhooks/shopify/orders-paid (HMAC of raw body)
